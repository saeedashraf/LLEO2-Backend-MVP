  "item": [
    {
      "name": "🏥 Health & Info",
      "description": "Service health, info, and debugging endpoints.",
      "item": [
        {
          "name": "GET / — Service Info",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/",
            "description": "Returns service info, version, features, and available endpoints."
          }
        },
        {
          "name": "GET /health — Deep Health Check",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health",
            "description": "Deep health check — checks database, storage, Vertex AI, and Earth Engine."
          }
        },
        {
          "name": "GET /processors — List Processors",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/processors",
            "description": "List all available analysis processors (ndvi, air_quality, water_quality, etc.)."
          }
        },
        {
          "name": "GET /processors/{type} — Processor Detail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/processors/air_quality",
            "description": "Details for a specific processor. Try: ndvi, air_quality, water_quality, weather_forecast, business_location"
          }
        },
        {
          "name": "GET /api/logs — Cloud Run Logs",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/logs?limit=50",
              "host": ["{{base_url}}"],
              "path": ["api", "logs"],
              "query": [
                { "key": "limit", "value": "50", "description": "Max logs to return (1-500)" }
              ]
            },
            "description": "Fetch recent Cloud Run logs from Cloud Logging (last 1 hour)."
          }
        }
      ]
    },
    {
      "name": "💬 Chat — Conversational Flow",
      "description": "The main conversational analysis flow.\n\nFlow: start → continue (optional, for clarifications) → analyze → poll status",
      "item": [
        {
          "name": "POST /chat/start — Start Conversation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.session_id) {",
                  "    pm.collectionVariables.set('session_id', jsonData.session_id);",
                  "    console.log('✅ session_id saved: ' + jsonData.session_id);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Has session_id', function() {",
                  "    pm.expect(jsonData).to.have.property('session_id');",
                  "});",
                  "",
                  "pm.test('Has status', function() {",
                  "    pm.expect(jsonData).to.have.property('status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat/start",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "query", "value": "air pollution levels in Holcim cement factory in Beočin, Serbia 2024", "description": "The user's question" },
                { "key": "user_id", "value": "{{user_id}}", "description": "User ID" },
                { "key": "user_email", "value": "{{user_email}}", "description": "User email (optional)" }
              ]
            },
            "description": "Start a new conversation. Saves session_id to collection variables automatically.\n\n**Sample queries to try:**\n- Vegetation: `Vegetation change in Fazenda Rio Preto I farm in Mato Grosso, Brazil in 2024`\n- Air Quality: `air pollution levels in Holcim cement factory in Beočin, Serbia 2024`\n- Water Quality: `Water quality in Henley Sewage Treatment Works in 2024`\n- Weather: `weather forecast Tokyo Japan`\n- Business: `find coffee shops near Zurich`\n- General: `what satellite data can you analyze?`"
          }
        },
        {
          "name": "POST /chat/continue — Follow-up Message",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.session_id) {",
                  "    pm.collectionVariables.set('session_id', jsonData.session_id);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat/continue",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "session_id", "value": "{{session_id}}", "description": "Session ID from /chat/start" },
                { "key": "message", "value": "all pollutants please", "description": "Follow-up message (e.g. answering clarification)" }
              ]
            },
            "description": "Continue a conversation with a follow-up message.\n\nUse this when LLEO asks for clarification (e.g. 'which pollutants?').\n\nAlso accepts `conversation_id` + `user_response` as legacy field names."
          }
        },
        {
          "name": "POST /chat/analyze — Trigger Analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.session_id) {",
                  "    pm.collectionVariables.set('analysis_session_id', jsonData.session_id);",
                  "    console.log('✅ analysis_session_id saved: ' + jsonData.session_id);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Has analysis session_id', function() {",
                  "    pm.expect(jsonData).to.have.property('session_id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/chat/analyze",
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "session_id", "value": "{{session_id}}", "description": "Session ID from /chat/start or /chat/continue" }
              ]
            },
            "description": "Trigger the actual satellite analysis after the conversation is complete.\n\nReturns an `analysis_session_id` to poll with /status/{session_id}.\n\n⚠️ This is the ANALYSIS session_id, not the chat session_id."
          }
        },
        {
          "name": "GET /chat/{session_id} — Get Session State",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/chat/{{session_id}}",
            "description": "Retrieve current conversation state including messages, intent, and location."
          }
        }
      ]
    },
    {
      "name": "🔬 Analysis — Legacy Direct",
      "description": "Legacy one-shot analysis endpoint (no conversation).",
      "item": [
        {
          "name": "POST /analyze — Direct Analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.session_id) {",
                  "    pm.collectionVariables.set('analysis_session_id', jsonData.session_id);",
                  "    console.log('✅ analysis_session_id saved: ' + jsonData.session_id);",
                  "}",
                  "",
                  "pm.test('Status code is 200', function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{base_url}}/analyze",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "query", "value": "Vegetation change in Mato Grosso, Brazil 2024", "description": "Analysis query" },
                { "key": "user_id", "value": "{{user_id}}", "description": "User ID" },
                { "key": "download_data", "value": "true", "description": "Whether to download raw data" }
              ]
            },
            "description": "Legacy one-shot analysis. Routes, geocodes, and launches analysis in one call.\n\nWill fail with 400 if clarification is needed — use /chat/start instead."
          }
        }
      ]
    },
    {
      "name": "📊 Status & Results",
      "description": "Poll analysis progress and retrieve results.",
      "item": [
        {
          "name": "GET /status/{session_id} — Poll Progress",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/status/{{analysis_session_id}}",
            "description": "Poll analysis progress. Returns status: processing | completed | failed.\n\nWhen completed, includes file URLs.\n\n⏳ Poll every 5 seconds until status is 'completed' or 'failed'."
          }
        },
        {
          "name": "GET /results/{session_id}/map — Interactive Map",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/results/{{analysis_session_id}}/map",
            "description": "Returns the interactive Folium map as HTML. Open in browser."
          }
        },
        {
          "name": "GET /results/{session_id}/chart — Chart Image",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/results/{{analysis_session_id}}/chart",
            "description": "Returns the analysis chart as a PNG image."
          }
        },
        {
          "name": "GET /results/{session_id}/preview — Thumbnail",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/results/{{analysis_session_id}}/preview",
            "description": "Returns a thumbnail preview image of the analysis."
          }
        },
        {
          "name": "GET /results/{session_id}/metadata — JSON Metadata",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/results/{{analysis_session_id}}/metadata",
            "description": "Returns analysis metadata: query, type, location, coordinates, timestamps, results_data."
          }
        },
        {
          "name": "GET /results/{session_id}/download — ZIP Archive",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/results/{{analysis_session_id}}/download",
            "description": "Download all analysis files as a ZIP archive."
          }
        },
        {
          "name": "DELETE /results/{session_id} — Delete Analysis",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{base_url}}/results/{{analysis_session_id}}?user_id={{user_id}}",
              "host": ["{{base_url}}"],
              "path": ["results", "{{analysis_session_id}}"],
              "query": [
                { "key": "user_id", "value": "{{user_id}}", "description": "Must match the owner" }
              ]
            },
            "description": "Delete an analysis and its files. User must own the analysis."
          }
        },
        {
          "name": "GET /gallery/{user_id} — User Gallery",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/gallery/{{user_id}}?limit=50&offset=0",
              "host": ["{{base_url}}"],
              "path": ["gallery", "{{user_id}}"],
              "query": [
                { "key": "limit", "value": "50", "description": "Max results (1-500)" },
                { "key": "offset", "value": "0", "description": "Pagination offset" }
              ]
            },
            "description": "List all analyses for a user with thumbnail/map/chart URLs."
          }
        },
        {
          "name": "GET /files/{session_id}/{filename} — Serve File",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/files/{{analysis_session_id}}/map.html",
            "description": "Serve any artefact file from GCS or local disk. Replace filename as needed."
          }
        }
      ]
    },
    {
      "name": "💳 Stripe — Billing & Subscriptions",
      "description": "Stripe billing endpoints. These are called by the frontend BillingPage.",
      "item": [
        {
          "name": "POST /api/billing/create-checkout-session",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/billing/create-checkout-session",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "user_email", "value": "{{user_email}}", "description": "User's email for Stripe customer" },
                { "key": "user_id", "value": "{{user_id}}", "description": "User ID (stored in Stripe metadata)" }
              ]
            },
            "description": "Create a Stripe Checkout session for Pro subscription ($1/month).\n\nReturns `checkout_url` — redirect the user to this URL."
          }
        },
        {
          "name": "POST /api/billing/create-portal-session",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/billing/create-portal-session",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "user_email", "value": "{{user_email}}", "description": "User's email (must have existing Stripe customer)" }
              ]
            },
            "description": "Create a Stripe Customer Portal session.\n\nReturns `portal_url` — redirect user to manage their subscription."
          }
        },
        {
          "name": "POST /api/billing/cancel-subscription",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/billing/cancel-subscription",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "user_email", "value": "{{user_email}}", "description": "User's email" }
              ]
            },
            "description": "Cancel the user's active subscription at end of billing period.\n\nDoes NOT immediately cancel — subscription stays active until period ends."
          }
        },
        {
          "name": "POST /api/billing/reactivate-subscription",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/billing/reactivate-subscription",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "user_email", "value": "{{user_email}}", "description": "User's email" }
              ]
            },
            "description": "Reactivate a subscription that was set to cancel at period end."
          }
        },
        {
          "name": "POST /api/stripe/webhook — Stripe Webhook",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/stripe/webhook",
            "header": [
              { "key": "stripe-signature", "value": "t=...,v1=...", "description": "Stripe webhook signature (auto-set by Stripe)" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"customer.subscription.created\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"sub_test\",\n      \"customer\": \"cus_test\",\n      \"status\": \"active\"\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "⚠️ This endpoint is called by Stripe, not by you.\n\nHandled events:\n- customer.subscription.created\n- customer.subscription.updated\n- customer.subscription.deleted\n- invoice.payment_succeeded\n- invoice.payment_failed\n\n**Webhook URL for Stripe Dashboard:**\n- LOCAL: Use Stripe CLI `stripe listen --forward-to localhost:8080/api/stripe/webhook`\n- CLOUD: `https://ndvi6-analysis-api-258557095482.us-central1.run.app/api/stripe/webhook`"
          }
        },
        {
          "name": "GET /credits/{user_id} — User Credits",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/credits/{{user_id}}",
            "description": "Get user's remaining credits from Supabase."
          }
        }
      ]
    },
