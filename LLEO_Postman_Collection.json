    {
      "name": "🗄️ Supabase — Direct API",
      "description": "Direct Supabase REST API calls. Uses the anon key for read-only, service role key for admin.\n\n**These bypass the LLEO backend** — they go directly to Supabase.",
      "item": [
        {
          "name": "GET analyses — List All (public)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/analyses?select=*&is_shared=eq.true&order=created_at.desc&limit=20",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "analyses"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "is_shared", "value": "eq.true" },
                { "key": "order", "value": "created_at.desc" },
                { "key": "limit", "value": "20" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "List shared analyses from Supabase (community page data)."
          }
        },
        {
          "name": "GET analyses — By User ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/analyses?select=*&user_id=eq.{{user_id}}&order=created_at.desc&limit=50",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "analyses"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "user_id", "value": "eq.{{user_id}}" },
                { "key": "order", "value": "created_at.desc" },
                { "key": "limit", "value": "50" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "List all analyses for a specific user."
          }
        },
        {
          "name": "GET user_credits — Check Credits",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/user_credits?select=*&user_id=eq.{{user_id}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "user_credits"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "user_id", "value": "eq.{{user_id}}" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "Check a user's credit balance."
          }
        },
        {
          "name": "GET subscriptions — Check Subscription",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/subscriptions?select=*&user_id=eq.{{user_id}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "subscriptions"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "user_id", "value": "eq.{{user_id}}" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "Check a user's subscription status (free/pro/enterprise, active/canceled)."
          }
        },
        {
          "name": "GET credit_transactions — Transaction History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/credit_transactions?select=*&user_id=eq.{{user_id}}&order=created_at.desc&limit=20",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "credit_transactions"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "user_id", "value": "eq.{{user_id}}" },
                { "key": "order", "value": "created_at.desc" },
                { "key": "limit", "value": "20" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "Get credit transaction history for a user."
          }
        },
        {
          "name": "GET conversation_messages — Chat History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/conversation_messages?select=*&conversation_id=eq.YOUR_CONVERSATION_ID&order=created_at.asc",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "conversation_messages"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "conversation_id", "value": "eq.YOUR_CONVERSATION_ID" },
                { "key": "order", "value": "created_at.asc" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "Get all messages in a conversation thread. Replace YOUR_CONVERSATION_ID with actual conversation_id from an analysis."
          }
        },
        {
          "name": "GET analysis_likes — Check Likes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/analysis_likes?select=*&user_id=eq.{{user_id}}",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "analysis_likes"],
              "query": [
                { "key": "select", "value": "*" },
                { "key": "user_id", "value": "eq.{{user_id}}" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_anon_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_anon_key}}" }
            ],
            "description": "Get all analyses liked by a user."
          }
        },
        {
          "name": "PATCH analyses — Share/Unshare (Admin)",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{supabase_url}}/rest/v1/analyses?id=eq.123",
              "host": ["{{supabase_url}}"],
              "path": ["rest", "v1", "analyses"],
              "query": [
                { "key": "id", "value": "eq.123", "description": "Analysis ID to update" }
              ]
            },
            "header": [
              { "key": "apikey", "value": "{{supabase_service_role_key}}" },
              { "key": "Authorization", "value": "Bearer {{supabase_service_role_key}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Prefer", "value": "return=representation" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_shared\": true,\n  \"shared_at\": \"2026-02-13T00:00:00Z\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "description": "⚠️ Requires service_role_key. Share or unshare an analysis. Replace `123` with actual analysis ID."
          }
        }
      ]
    },
