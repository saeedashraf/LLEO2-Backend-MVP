    {
      "name": "🧪 Sample Flows",
      "description": "Pre-configured test flows. Run these in order.",
      "item": [
        {
          "name": "Flow 1: Air Quality (Serbia)",
          "description": "Complete air quality analysis flow with clarification.\n\n1. Start → asks which pollutants\n2. Continue → 'all'\n3. Analyze → triggers analysis\n4. Poll status until completed",
          "item": [
            {
              "name": "1. Start — Air Quality Query",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.collectionVariables.set('session_id', jsonData.session_id);",
                      "console.log('Session: ' + jsonData.session_id);",
                      "console.log('Status: ' + jsonData.status);",
                      "console.log('Message: ' + jsonData.message);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{base_url}}/chat/start",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "query", "value": "air pollution levels in Holcim cement factory in Beočin, Serbia 2024" },
                    { "key": "user_id", "value": "{{user_id}}" },
                    { "key": "user_email", "value": "{{user_email}}" }
                  ]
                }
              }
            },
            {
              "name": "2. Continue — All Pollutants",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "console.log('Status: ' + jsonData.status);",
                      "console.log('Ready: ' + jsonData.ready_to_analyze);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{base_url}}/chat/continue",
                "body": {
                  "mode": "formdata",
                  "formdata": [
                    { "key": "session_id", "value": "{{session_id}}" },
                    { "key": "message", "value": "all pollutants please" }
                  ]
                }
              }
            },
            {
              "name": "3. Analyze — Trigger",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "var jsonData = pm.response.json();",
                      "pm.collectionVariables.set('analysis_session_id', jsonData.session_id);",
                      "console.log('Analysis Session: ' + jsonData.session_id);"
                    ]
                  }
                }
              ],
              "request": {
                "method": "POST",
                "url": "{{base_url}}/chat/analyze",
                "body": {
                  "mode": "urlencoded",
                  "urlencoded": [
                    { "key": "session_id", "value": "{{session_id}}" }
                  ]
                }
              }
            },
            {
              "name": "4. Poll Status",
              "request": {
                "method": "GET",
                "url": "{{base_url}}/status/{{analysis_session_id}}"
              }
            }
          ]
        },
